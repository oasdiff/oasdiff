#!/usr/bin/env bash
set -euo pipefail

echo "==> Running pre-commit hook"

before=$(git diff --name-only)
make lint
make test
after=$(git diff --name-only)

if [ "$before" != "$after" ]; then
    echo "make changed files; review and stage them, then commit again:"
    comm -13 <(echo "$before") <(echo "$after")
    exit 1
fi
